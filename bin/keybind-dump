#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Run keybind_dump CLI using uv via mise or direct
if command -v mise >/dev/null 2>&1; then
    exec mise exec -- uv run keybind-dump "$@"
elif command -v uv >/dev/null 2>&1; then
    exec uv run --directory "${REPO_ROOT}" keybind-dump "$@"
else
    export PYTHONPATH="${REPO_ROOT}/src:${PYTHONPATH:-}"
    exec python3 -m keybind_dump "$@"
fi
